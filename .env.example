# 数据库（本地开发用 file:，生产环境用 Turso libsql://）
DATABASE_URL=file:./data/lingua.db
# DATABASE_AUTH_TOKEN=

# 鉴权密钥：openssl rand -base64 32
AUTH_SECRET=please-change-this-secret

# AI（可选）：任意 OpenAI 兼容接口，未配置时 AI 功能返回 503
# DeepSeek 配置示例：
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
#
# OpenAI 配置示例：
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
